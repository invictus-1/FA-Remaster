<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The program's file names are UTF-8 everywhere (hostfs, vfs, the options). This makes Windows hand the
     arguments in UTF-8 and take UTF-8 in every narrow file call (Windows 10 1903 and later), so a user name
     or game folder with letters outside the PC's own code page opens like any other. All three programs
     link it (src/app/utf8.rc). -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
